{
	"name": "pushq-web",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run keep",
		"keep": "node -e \"require('fs').writeFileSync('build/.gitkeep','')\"",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"prepare": "svelte-kit sync || echo ''"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.8",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"autoprefixer": "^10.4.20",
		"clsx": "^2.1.1",
		"postcss": "^8.4.49",
		"svelte": "^5.25.0",
		"svelte-check": "^4.1.0",
		"tailwind-merge": "^2.6.0",
		"tailwindcss": "^3.4.17",
		"typescript": "^5.6.0",
		"vite": "^7.0.0"
	}
}
