# Copy to .env (gitignored) — `pushq serve` loads it from the working directory.
# Real environment variables override values here.

# SaaS mode: set both to make WorkOS AuthKit the only sign-in, with teams as
# WorkOS Organizations and each team's data isolated. Leave unset for a
# self-hosted server with local accounts.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
# Optional: where WorkOS sends people back after sign-in. Must be listed under
# Redirects in the WorkOS dashboard. Default: <server origin>/v1/auth/workos/callback
# WORKOS_REDIRECT_URI=https://pushq.example.com/v1/auth/workos/callback

# PUSHQ_DB=postgres://user:pass@host/pushq
# PUSHQ_API_KEYS=admin:pq_operator_key   # operator keys (see every team in SaaS mode)
